; ============================================================
; Aether Platform — custom NSIS installer hooks.
; Loaded by electron-builder via "nsis.include" (package.json).
;
; The NSIS target is configured with oneClick=false and
; allowToChangeInstallationDirectory=true, so users get the full
; assisted install wizard (license / directory / install pages).
;
; To add a custom animated wizard banner:
;   1. Ship a 164x314 BMP next to this file (build/installer-side.bmp).
;   2. Uncomment the MUI_WELCOMEFINISHPAGE_BITMAP defines below.
;   3. For a true animation (GIF/AVI), use the AnimGif plugin:
;      https://nsis.sourceforge.io/AnimGif_plug-in
; ============================================================

; Custom branded side banner (generated by scripts/generate-installer-banner.mjs).
; The path is resolved relative to the frontend/ directory.
;!define MUI_WELCOMEFINISHPAGE_BITMAP "build\installer-side.bmp"
;!define MUI_UNWELCOMEFINISHPAGE_BITMAP "build\installer-side.bmp"

!macro customInstall
  ; Post-install hook: runs after files are copied to $INSTDIR.
  ; Example: launch the app immediately after install:
  ;   ExecShell "open" "$INSTDIR\Aether Platform.exe"
!macroend

!macro customUnInstall
  ; Pre-uninstall cleanup hook.
!macroend
