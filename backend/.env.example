# Aether backend - local environment template
# 1) Start MySQL (see README), e.g.:
#      docker run -d --name aether-mysql -e MYSQL_ROOT_PASSWORD=<your-password> \
#        -e MYSQL_DATABASE=aether_db -p 3306:3306 mysql:8.0
# 2) Export the same values below, then run the backend.
# Never commit real secrets; keep them out of git (.env is git-ignored).

DB_URL=jdbc:mysql://localhost:3306/aether_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me
SERVER_PORT=8080

# Optional: swap to a real local embedding model / vector database (Epic 2).
# AETHER_EMBEDDING_PROVIDER=ollama
# AETHER_EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
# AETHER_EMBEDDING_OLLAMA_MODEL=bge-m3
# AETHER_EMBEDDING_OLLAMA_DIMENSIONS=1024
# AETHER_VECTORSTORE_PROVIDER=qdrant
# AETHER_VECTORSTORE_QDRANT_BASE_URL=http://localhost:6333
# AETHER_VECTORSTORE_QDRANT_COLLECTION=aether_atoms
